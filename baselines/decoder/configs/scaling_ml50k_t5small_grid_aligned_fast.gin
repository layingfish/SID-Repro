import data.processed

train.backbone="t5_small"
train.hf_model_path="models/t5-small"
train.hf_local_files_only=True
train.num_user_tokens=1

train.dataset_folder="data/decoder"
train.dataset=%data.processed.RecDataset.AMAZON
train.dataset_split="microlens_50k"
train.force_dataset_process=False

train.learning_rate=0.001
train.weight_decay=0.0001
train.batch_size=256
train.gradient_accumulate_every=2

train.iterations=80000
train.save_model_every=10000

train.amp=True
train.mixed_precision_type="bf16"

train.vae_input_dim=768
train.vae_n_cat_feats=0
train.vae_hidden_dims=[512, 256, 128]
train.vae_embed_dim=32
train.vae_codebook_size=256
train.vae_n_layers=3

train.pretrained_rqvae_path=None
train.save_dir_root="runs/scaling_ml50k/default/decoder/"
train.wandb_logging=False
