+def prefix_allowed_tokens_fn(candidate_trie, fallback_token_id: int = 1):
+    """Return a HF `prefix_allowed_tokens_fn` that never returns an empty list.
+
+    Some datasets / checkpoints may produce prefixes not present in the candidate trie.
+    HF generation treats an empty allowed-token set as an unsatisfiable constraint and raises.
+    We fall back to allowing EOS (default: 1 for T5) to gracefully terminate generation.
+    """
+
     def prefix_allowed_tokens(batch_id, sentence):
         sentence = sentence.tolist()
         trie_out = candidate_trie.get(sentence)
+        if not trie_out:
+            return [fallback_token_id]
         return trie_out
 
     return prefix_allowed_tokens
