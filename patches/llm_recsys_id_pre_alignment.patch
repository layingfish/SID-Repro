@@ -23,6 +23,28 @@ import pickle as pkl
 warnings.filterwarnings("ignore")
 
 
+_DIGITS = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+
+
+def change_base(num_str, base):
+    """Convert a non-negative base-10 integer string to the given base.
+
+    This helper is used by the item ID indexing utilities.
+    """
+    n = int(num_str)
+    if n < 0:
+        raise ValueError(f"num_str must be non-negative, got {num_str!r}")
+    if base < 2 or base > len(_DIGITS):
+        raise ValueError(f"base must be in [2, {len(_DIGITS)}], got {base}")
+    if n == 0:
+        return "0"
+    out = []
+    while n:
+        n, r = divmod(n, base)
+        out.append(_DIGITS[r])
+    return "".join(reversed(out))
+
+
 def random_number(max_number, min_number=0):
     randomized_number = list(range(min_number, max_number))
     random.shuffle(randomized_number)
