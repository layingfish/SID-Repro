+                batch_y,
+                data_gpu[i],
+                type=type_list[i],
+                use_con=False,
+                use_guide=False,
+                guide_feat=guide_feat,
+            )
+            loss += loss_i
+            contra_loss += contra_i
+
+        loss.backward()
+        model_optimizer.step()
+        curr_lr = lr_scheduler.step_update(train_model_list[0].batch_num)
+        model_optimizer.zero_grad()
+
+        loss_history.append(float(loss.detach().cpu()))
+        contra_history.append(float(contra_loss.detach().cpu()))
+
+        if train_model_list[0].batch_num % args.eval_step == 0:
+            eval_and_maybe_save(train_model_list[0].batch_num, float(curr_lr))
+
+        if train_model_list[0].batch_num >= args.total_batch_num:
+            break
+
+    final_path = ckpt_dir / "last.pt"
+    meta_last = {
