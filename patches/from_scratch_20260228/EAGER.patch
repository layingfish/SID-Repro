+    else:
+        print("[EAGER][SETRec] WARNING: best checkpoint not found; exporting with last weights")
+
+    for i in range(args.tree_num):
+        train_model_list[i].trm_model.eval()
+
+    preds_test = _predict_all(
+        test_instances,
+        train_model_list,
+        type_list,
+        topk=args.export_topk,
