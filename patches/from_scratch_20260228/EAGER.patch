+"""EAGER on SETRec datasets (beauty/toys/sports/steam).
+
+This adapter is for RecSys26 strict reproductions on the SETRec paper dataset.
+
+Key choices:
+- Training uses SETRec training_dict.npy only.
+- Validation uses multi-target labels from validation_dict.npy.
+- Test export uses multi-target labels from testing_dict.npy.
+- Test histories are built from train+val (no test leakage).
+
+Outputs:
+- Saves checkpoints to --ckpt_dir (best on val NDCG@10 + last).
+- Exports predictions JSONL to --pred_out (top-k per user) for unified_eval.
+"""
+
+import argparse
+import json
+import math
+import os
+import random
+from pathlib import Path
+
+import numpy as np
+import torch
+
+from lib.generate_train_and_test_data import _gen_train_sample
+from lib.generate_training_batches import Train_instance
+from lib import Trm4Rec
+
+from optimizers import AdamOptimizer
+from optimizers.lr_schedulers import InverseSquareRootSchedule
+
+
+def build_sample_from_user_seqs(user_seqs: dict[int, list[int]]) -> dict[str, np.ndarray]:
+    user_ids: list[int] = []
+    item_ids: list[int] = []
+    timestamps: list[int] = []
+
+    for user_id, seq in user_seqs.items():
+        for t, item_id in enumerate(seq):
+            user_ids.append(int(user_id))
+            item_ids.append(int(item_id))
+            timestamps.append(int(t))
+
+    user_ids_arr = np.asarray(user_ids, dtype=np.int64)
+    item_ids_arr = np.asarray(item_ids, dtype=np.int64)
+    timestamps_arr = np.asarray(timestamps, dtype=np.int64)
+
+    zeros = np.zeros_like(user_ids_arr)
+    return {
+        "USERID": user_ids_arr,
+        "ITEMID": item_ids_arr,
+        "CATID": zeros,
+        "BEHAV": zeros,
+        "TS": timestamps_arr,
+    }
+
+
+def _pad_left(seq: list[int], length: int, pad_value: int = -1) -> list[int]:
+    if length <= 0:
+        return []
+    if len(seq) >= length:
+        return seq[-length:]
+    return [pad_value] * (length - len(seq)) + seq
+
+
+def write_instances_file(
+    out_path: Path,
+    user_histories: dict[int, list[int]],
+    user_labels: dict[int, list[int]],
+    history_len: int,
+    include_only_nonempty_labels: bool,
+) -> list[int]:
+    """Write EAGER instance file.
+
+    Format per line (compatible with Train_instance.read_*_instances_file):
+      user_id|h1,h2,...,h_{history_len}|label1,label2,...
+
+    Returns the ordered list of user_ids written.
+    """
+    out_path.parent.mkdir(parents=True, exist_ok=True)
+    users: list[int] = []
+
+    with out_path.open("w", encoding="utf-8") as f:
+        for user_id in sorted(user_histories.keys()):
+            labels = user_labels.get(user_id, [])
+            if include_only_nonempty_labels and (not labels):
+                continue
+            history = [int(x) for x in user_histories[user_id]]
+            history_fixed = _pad_left(history, history_len, pad_value=-1)
+            label_str = ",".join(str(int(x)) for x in labels)
+            hist_str = ",".join(str(x) for x in history_fixed)
+            line = f"{int(user_id)}|{hist_str}|{label_str}\n"
+            users.append(int(user_id))
+            f.write(line)
+
+    return users
+
+
+def presision(result_list, gt_list, top_k):
+    count = 0.0
+    for r, g in zip(result_list, gt_list):
+        count += len(set(r).intersection(set(g)))
+    return count / (top_k * len(result_list))
+
+
+def recall(result_list, gt_list):
+    t = 0.0
+    for r, g in zip(result_list, gt_list):
+        t += 1.0 * len(set(r).intersection(set(g))) / len(g)
+    return t / len(result_list)
+
+
+def hit_ratio(result_list, gt_list):
+    intersect_set = [len(set(r) & set(g)) for r, g in zip(result_list, gt_list)]
+    return 1.0 * sum(intersect_set) / sum([len(gts) for gts in gt_list])
+
+
+def ndcg_bug(result_list, gt_list):
+    t = 0.0
+    for re, gt in zip(result_list, gt_list):
+        setgt = set(gt)
+        indicator = np.asfarray([1 if r in setgt else 0 for r in re])
+        sorted_indicator = indicator[indicator.argsort(-1)[::-1]]
+        if 1 in indicator:
+            t += np.sum(indicator / np.log2(1.0 * np.arange(2, len(indicator) + 2))) / np.sum(
+                sorted_indicator / np.log2(1.0 * np.arange(2, len(indicator) + 2))
+            )
+    return t / len(gt_list)
+
+
+def rerank(batch_x, label, train_model_list, rerank_topk, type_list):
+    tree_num = len(train_model_list)
+    if tree_num == 1:
+        return label
+
+    device = batch_x.device
+    scores = torch.full((len(batch_x), rerank_topk * tree_num), -1e15, device=device)
+    input_labels = torch.zeros((len(batch_x), rerank_topk * tree_num), dtype=torch.int64, device=device)
+    max_lenr = rerank_topk
+
+    for i, result in enumerate(label):
+        r = torch.LongTensor(list(set(result.tolist()))).to(device)
+        scores[i, 0 : len(r)] = 0.0
+        input_labels[i, 0 : len(r)] = r
+        max_lenr = max(max_lenr, len(r))
+
+    scores = scores[:, 0:max_lenr]
+    input_labels = input_labels[:, 0:max_lenr]
+    input_user = batch_x.repeat_interleave(max_lenr, dim=0)
+    input_item = input_labels.reshape(-1)
+
+    with torch.no_grad():
+        for j in range(tree_num):
+            scores += train_model_list[j].compute_scores(input_user, input_item, type=type_list[j]).sum(-1).view(
+                batch_x.shape[0], -1
+            )
+        argindex = scores.argsort(-1, True)[:, :rerank_topk]
+        final_result = input_labels.gather(index=argindex, dim=-1)
+
+    return final_result
+
+
+def _save_checkpoint(path: Path, train_model_list, meta: dict) -> None:
+    path.parent.mkdir(parents=True, exist_ok=True)
+    ckpt = {
+        "meta": meta,
+        "state_dicts": [m.trm_model.state_dict() for m in train_model_list],
+    }
+    torch.save(ckpt, str(path))
+
+
+def _load_checkpoint(path: Path, train_model_list) -> dict:
+    ckpt = torch.load(str(path), map_location="cpu")
+    state_dicts = ckpt.get("state_dicts", [])
+    if len(state_dicts) != len(train_model_list):
+        raise ValueError(f"Checkpoint tree_num mismatch: {len(state_dicts)} vs {len(train_model_list)}")
+    for i, m in enumerate(train_model_list):
+        m.trm_model.load_state_dict(state_dicts[i])
+    return ckpt
+
+
+def _predict_all(
+    instances: torch.Tensor,
+    train_model_list,
+    type_list,
+    topk: int,
+    rerank_topk: int,
+    batch_size: int,
+) -> np.ndarray:
+    num_batch = math.ceil(instances.shape[0] / batch_size)
+    all_batches: list[torch.Tensor] = []
+
+    for j in range(num_batch):
+        batch_user = instances[j * batch_size : (j + 1) * batch_size].to("cuda")
+        batch_result_list = []
+        for i in range(len(train_model_list)):
+            batch_result_one_tree = train_model_list[i].predict(batch_user, topk=topk, type=type_list[i])
+            batch_result_list.append(batch_result_one_tree)
+
+        batch_result = torch.cat(batch_result_list, dim=-1)
+        batch_result = rerank(batch_user, batch_result, train_model_list, rerank_topk, type_list)
+        all_batches.append(batch_result.detach().cpu())
+
+    return torch.cat(all_batches, dim=0).numpy()
+
+
+def main():
