diff --git a/config/SETRec_beauty/SEATER.yaml b/config/SETRec_beauty/SEATER.yaml
new file mode 100644
index 0000000..8164805
--- /dev/null
+++ b/config/SETRec_beauty/SEATER.yaml
@@ -0,0 +1,43 @@
+lr: 0.001
+min_lr: 0.001
+weight_decay: 0.00001 # l2 norm
+# patience: 2 # Number of epochs with no improvement after which learning rate will be reduced
+es_patience: 4 #patience for early stop
+
+
+## item embedding
+embedding_dim: 64
+  # ID: 48  #item ID
+  # cate: 16
+
+d_model: 64
+
+Encoder:
+  N_layer: 1
+  nhead: 2
+  inner_dim: 256
+  dropout: 0.2
+
+Decoder:
+  N_layer: 1
+  nhead: 2
+  inner_dim: 256
+  dropout: 0.2
+
+
+## decoder item index
+decoder_index:
+  vocab_size: 2 # radix, such as decimal # will be rewriten according to the tree
+  embedding_dim: 64
+  tree_nodes_num: 1 # will be rewriten according to the tree
+  max_len: 1 #will be rewriten according to the tree
+
+rk_weight: 0.05
+
+rk_num_neg: 4
+rk_margin: 0.001
+
+rk_act : 'sigmoid'
+
+sm_temp: 0.2
+sm_weight: 0.05
\ No newline at end of file
